  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>-Dfile.encoding=UTF-8</argLine><systemPropertyVariables><appointment.timeout-scan.enabled>false</appointment.timeout-scan.enabled></systemPropertyVariables></configuration></plugin>
 </plugins></build>
 <profiles><profile><id>it</id><build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><configuration><systemPropertyVariables><appointment.timeout-scan.enabled>false</appointment.timeout-scan.enabled></systemPropertyVariables></configuration><executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions></plugin></plugins></build></profile></profiles>
